    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.170",
    "ansi-to-react": "^6.2.6",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
