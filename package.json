{
  "name": "aichemist-ui",
  "private": true,
  "version": "1.3.0",
  "description": "AIchemist — an Electron desktop client for coding agents.",
  "author": {
    "name": "Anras573",
    "email": "Anras573@users.noreply.github.com"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "dev": "node scripts/build-canvas-sdk-esm.mjs && electron-vite dev",
    "build": "electron-vite build && node scripts/build-canvas-sdk-esm.mjs",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3 -w node-pty",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:canvas-sdk": "node scripts/smoke-test-canvas-sdk.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
